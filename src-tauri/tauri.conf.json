{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noto",
  "version": "1.1.5",
  "identifier": "app.notto.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noto",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#f7f8fa",
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["German"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRUNGQjlGQUQ4NDJGREIKUldUYkw0U3RuL3ZzWUdhOXNscTNpR3VmOXdtNDZwL3E5OTVwaDgxS0Yyc3RleFhLUkFhM3BFREUK",
      "endpoints": ["https://github.com/Hubertoink/Notto/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
